:80 {
	encode zstd gzip

	# Public Go REST includes authenticated access to the Python AI service.
	# Never expose the internal Python service token to the browser.
	@api path /api/* /health /ready
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /var/www/html/dist
		try_files {path} /index.html
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy same-origin
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
			Cache-Control "no-cache"
		}
		file_server
	}
}
