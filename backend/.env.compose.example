POSTGRES_USER=buddy
POSTGRES_PASSWORD=buddy-local
POSTGRES_DB=buddy

DEMO_MODE=true
DATABASE_URL=postgres://buddy:buddy-local@db:5432/buddy?sslmode=disable
HTTP_ADDR=:8080
MOCK_ADDR=:8090
MOCK_URL=http://mock-access:8090
MOCK_TOKEN=local-mock-token
MOCK_GRANT_AFTER=30s
RECONCILE_ENABLED=true
RECONCILE_INTERVAL=1s
RECONCILE_POLL_INTERVAL=5s
RECONCILE_TIMEOUT=10s
RECONCILE_LEASE=30s
RECONCILE_RETRY_BASE=5s
RECONCILE_RETRY_MAX=5m
RECONCILE_BATCH_SIZE=32
RAG_GRPC_TARGET=rag:50051
RAG_SERVICE_TOKEN=local-rag-token
